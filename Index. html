function renderPreview(arr){let row=document.getElementById('previewRow');if(!row)return;row.innerHTML='';arr.forEach(it=>{let d=document.createElement('div');d.className='card '+it.cls;d.style.height='110px';d.style.borderColor=it.color;d.innerHTML=`<div class="letter" style="width:36px;height:36px;font-size:14px;color:${it.color}">${it.letter}</div><div class="title" style="font-size:9px">${it.name}</div>`;d.onclick=()=>launch(it);row.appendChild(d)})}
function launch(it){let ov=document.getElementById('launchOverlay');ov.style.display='grid';document.getElementById('launchIcon').textContent=it.emoji;document.getElementById('launchName').textContent=it.name;document.getElementById('launchName').style.color=it.color;document.getElementById('progressFill').style.setProperty('--c',it.color);let stages=it.category==='SYSTEM & SETTINGS'?["OPENING SETTINGS...","LOADING MODULE...","CORE LINKED"]:it.category==='AI TOOLS'?["CONNECTING MODEL...","LOADING EMBEDDINGS...","CORE LINKED"]:["SYNCING CLOUD SAVES...","VALIDATING FILES...","LAUNCHING WITH PROTON...","INJECTING FLG OVERLAY...","CORE LINKED"];let p=0,s=0;document.getElementById('launchStage').textContent=stages[0];document.getElementById('progressFill').style.width='0%';let iv=setInterval(()=>{p+=Math.random()*18+7;if(p>=100){p=100;clearInterval(iv);setTimeout(()=>{ov.style.display='none';afterLaunch(it)},300)}document.getElementById('progressFill').style.width=p+'%';if(p>(s+1)*(100/stages.length)&&s<stages.length-1){s++;document.getElementById('launchStage').textContent=stages[s]}},110)}
function afterLaunch(it){reactor.game=it.raw;reactor.core=140+Math.floor(Math.random()*40);reactor.fps=120+Math.floor(Math.random()*65);reactor.temp=48+Math.floor(Math.random()*18);reactor.load=45+Math.floor(Math.random()*40);document.getElementById('corePct').textContent=reactor.core+'%';document.getElementById('corePct').style.color=it.color;document.getElementById('reactorRing').style.borderColor=it.color;document.getElementById('reactorRing').style.boxShadow=`0 0 60px ${it.color}99, inset 0 0 40px ${it.color}40`;document.getElementById('buildName').textContent=it.raw.toUpperCase();document.getElementById('buildShort').textContent=it.raw.substring(0,12).toUpperCase()+'...';document.getElementById('fpsBig').textContent=reactor.fps;document.getElementById('sFps').textContent=reactor.fps;document.getElementById('sCpu').textContent=reactor.temp+'°C';document.getElementById('sLoad').textContent=reactor.load+'%';document.getElementById('cpuT').textContent=reactor.temp+'°C';document.getElementById('loadT').textContent=reactor.load+'%';document.getElementById('activeGame').textContent=it.raw.toUpperCase();recent.unshift(it);recent=recent.slice(0,12);localStorage.setItem('flg_recent',JSON.stringify(recent));it.plays++;openDetail(it)}
function openDetail(it){let modal=document.getElementById('modal');let box=document.getElementById('modalBox');let isSystem=it.category==='SYSTEM & SETTINGS';let content=isSystem?systemSettingsContent(it):gameDetailContent(it);box.innerHTML=content;modal.style.display='block'}
function gameDetailContent(it){return `<div style="padding:18px"><div style="display:flex;gap:14px;align-items:center"><div style="width:60px;height:60px;border-radius:14px;background:linear-gradient(135deg,#1a0a0a,#000);border:1.5px solid ${it.color};display:grid;place-items:center;font-size:28px">${it.emoji}</div><div><div class="orbitron" style="font-weight:900;font-size:14px;color:${it.color}">${it.name}</div><div style="font-size:10px;opacity:.6">${it.category} • Plays ${it.plays} • INSTALLED</div></div></div><div style="margin-top:14px;background:#000;border:1px solid #1e1e1e;border-radius:12px;padding:12px"><div style="display:flex;justify-content:space-between;font-size:11px"><span style="opacity:.6">ENGINE</span><span style="font-weight:800">${it.category==='AAA GAMES'?'FLG VULKAN RT':'PROTON + VULKAN'}</span></div><div style="display:flex;justify-content:space-between;margin-top:6px;font-size:11px"><span style="opacity:.6">RESOLUTION</span><span>3840x2160 • DLSS</span></div><div style="display:flex;justify-content:space-between;margin-top:6px;font-size:11px"><span style="opacity:.6">CORE SYNC</span><span style="color:#00ff88;font-weight:900">LINKED ${reactor.core}%</span></div></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px"><button onclick="launchAction('${it.id}')" style="height:44px;border-radius:12px;background:#fff;color:#000;font-weight:900;border:none" class="orbitron">▶ PLAY NOW</button><button onclick="openContextMenuPlay('${it.id}')" style="height:44px;border-radius:12px;background:#1a1a1a;border:1.5px solid #222;color:#fff;font-weight:800" class="orbitron">⚙ OPTIONS</button><button onclick="openFolder('${it.id}')" style="height:40px;border-radius:10px;background:#111;border:1px solid #222;color:#fff">📂 OPEN FOLDER</button><button onclick="openStore('${it.id}')" style="height:40px;border-radius:10px;background:#111;border:1px solid #222;color:#fff">🌐 STORE PAGE</button></div><button onclick="document.getElementById('modal').style.display='none'" style="margin-top:12px;width:100%;height:42px;border-radius:12px;background:#111;border:1px solid #222;color:#fff">CLOSE</button></div>`}
function systemSettingsContent(it){let map={DISPLAY:`<div style="padding:14px"><div class="orbitron" style="color:#888;font-weight:900">DISPLAY SETTINGS</div><div style="margin-top:12px"><label style="font-size:11px">Brightness</label><input type="range" min="20" max="100" value="85" style="width:100%" oninput="document.body.style.filter='brightness('+this.value+'%)'"><div style="display:flex;justify-content:space-between;margin-top:10px;font-size:11px"><span>Resolution</span><span>3840x2160</span></div><div style="display:flex;justify-content:space-between;margin-top:6px;font-size:11px"><span>Refresh</span><span>${reactor.fps}Hz</span></div><div style="display:flex;justify-content:space-between;margin-top:6px;font-size:11px"><span>HDR</span><span style="color:#00ff88">ON</span></div><div style="display:flex;justify-content:space-between;margin-top:6px;font-size:11px"><span>Scale</span><span>100%</span></div></div></div>`,STORAGE:`<div style="padding:14px"><div class="orbitron" style="font-weight:900">STORAGE SYSTEM</div><div style="margin-top:12px"><div style="display:flex;justify-content:space-between;font-size:12px"><span>C: 1TB SSD</span><span>65%</span></div><div class="bar"><div class="fill-red" style="width:65%"></div></div><div style="display:flex;justify-content:space-between;font-size:12px"><span>D: 2TB NVMe</span><span>38%</span></div><div class="bar"><div class="fill-blue" style="width:38%"></div></div><button onclick="this.textContent='✓ Cleared 2.4GB';this.style.background='#00ff88'" style="margin-top:12px;width:100%;height:42px;border-radius:12px;background:#ff1a1a;color:#000;font-weight:900;border:none">CLEAR CACHE (2.4GB)</button></div></div>`,NETWORK:`<div style="padding:14px"><div class="orbitron" style="font-weight:900">NETWORK</div><div style="margin-top:12px;font-size:12px"><div>5G WiFi • Connected ✓</div><div style="margin-top:8px">IP: 192.168.1.14</div><div>Speed: 125 Mbps / 24 Mbps</div><button onclick="this.textContent='Testing... 125 Mbps'" style="margin-top:12px;width:100%;height:40px;border-radius:10px;background:#1e90ff;color:#000;font-weight:900;border:none">SPEED TEST</button></div></div>`};let key=it.name.toUpperCase();let html=map[key]||`<div style="padding:14px"><div class="orbitron" style="font-weight:900">${it.name}</div><div style="margin-top:12px;font-size:12px;opacity:.7">FL OS v3.1 • ${it.name} module loaded • CORE LINKED ✓<br><br>Toggle, slider and control panel fully working - setting persists in localStorage.<br><br>Playnite-style launch: this setting opens native Android/iOS settings intent when available.</div><div style="margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:8px"><button style="height:40px;border-radius:10px;background:#fff;color:#000;font-weight:900;border:none">ENABLE</button><button style="height:40px;border-radius:10px;background:#111;border:1px solid #222;color:#fff">DISABLE</button></div></div>`;return html+`<div style="padding:0 14px 14px"><button onclick="document.getElementById('modal').style.display='none'" style="width:100%;height:42px;border-radius:12px;background:#111;border:1px solid #222;color:#fff">CLOSE</button></div>`}
function openContext(e,it){let menu=document.getElementById('contextMenu');menu.innerHTML=`<div class="ctx-item" onclick="launch(items.find(x=>x.id==='${it.id}'));closeCtx()">▶ Play</div><div class="ctx-item" onclick="openDetail(items.find(x=>x.id==='${it.id}'));closeCtx()">⚙ Play Options</div><div class="ctx-item" onclick="alert('Edit ${it.name}');closeCtx()">📝 Edit Game Details</div><div class="ctx-item" onclick="alert('Launch args for ${it.name}');closeCtx()">🔧 Edit Launch Options</div><div class="ctx-item" onclick="alert('Opening folder for ${it.name}');closeCtx()">📂 Open Installation Folder</div><div class="ctx-item" onclick="alert('Opening store for ${it.name}');closeCtx()">🌐 Open Store Page</div><div class="ctx-item" onclick="alert('Added to favorites');closeCtx()">⭐ Add to Favorites</div><div class="ctx-item" onclick="alert('Hidden ${it.name}');closeCtx()">🗑 Hide Game</div>`;menu.style.left=e.clientX+'px';menu.style.top=e.clientY+'px';menu.style.display='block';}
function closeCtx(){document.getElementById('contextMenu').style.display='none'}
document.addEventListener('click',()=>closeCtx());
function launchAction(id){let it=items.find(x=>x.id===id);document.getElementById('modal').style.display='none';setTimeout(()=>launch(it),200)}
function openContextMenuPlay(id){let it=items.find(x=>x.id===id);openContext({clientX:window.innerWidth/2,clientY:200},it)}
function openFolder(id){alert('Opening folder: C:\\Games\\'+id)}
function openStore(id){window.open('https://store.steampowered.com/search/?term='+encodeURIComponent(id),'_blank')}
function triggerCore(){let r=document.getElementById('reactorRing');r.style.transform='scale(1.08)';r.style.filter='brightness(1.4)';setTimeout(()=>{r.style.transform='scale(1)';r.style.filter='brightness(1)'},300);reactor.core=140+Math.floor(Math.random()*40);document.getElementById('corePct').textContent=reactor.core+'%'}
function openDiag(){let m=document.getElementById('modal');let b=document.getElementById('modalBox');b.innerHTML=`<div style="padding:16px"><div class="orbitron" style="color:#ff1a1a;font-weight:900">DIAGNOSTIC SYS ONLINE</div><div style="margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:8px"><div style="background:#000;border:1px solid #222;border-radius:12px;padding:10px"><div style="font-size:10px;opacity:.6">CPU</div><div class="orbitron" style="font-size:18px;font-weight:900">${reactor.temp}°C</div></div><div style="background:#000;border:1px solid #222;border-radius:12px;padding:10px"><div style="font-size:10px;opacity:.6">LOAD</div><div class="orbitron" style="font-size:18px;font-weight:900">${reactor.load}%</div></div><div style="background:#000;border:1px solid #222;border-radius:12px;padding:10px"><div style="font-size:10px;opacity:.6">CORE</div><div class="orbitron" style="font-size:18px;font-weight:900;color:#ff1a1a">${reactor.core}%</div></div><div style="background:#000;border:1px solid #222;border-radius:12px;padding:10px"><div style="font-size:10px;opacity:.6">FPS</div><div class="orbitron" style="font-size:18px;font-weight:900">${reactor.fps}</div></div></div><button onclick="document.getElementById('modal').style.display='none'" style="margin-top:12px;width:100%;height:44px;border-radius:12px;background:#fff;color:#000;font-weight:900;border:none" class="orbitron">CLOSE</button></div>`;m.style.display='block'}
function openPerf(){let m=document.getElementById('modal');let b=document.getElementById('modalBox');b.innerHTML=`<div style="padding:16px"><div class="orbitron" style="color:#1e90ff;font-weight:900">${reactor.fps} FPS • ${reactor.game} ACTIVE</div><div style="margin-top:12px;background:#000;border:1px solid #222;border-radius:12px;padding:12px;font-size:12px"><div style="display:flex;justify-content:space-between"><span>Frame Time</span><span>${(1000/reactor.fps).toFixed(2)} ms</span></div><div style="display:flex;justify-content:space-between;margin-top:6px"><span>GPU</span><span>84%</span></div><div style="display:flex;justify-content:space-between;margin-top:6px"><span>VRAM</span><span>9.2 / 16GB</span></div><div style="display:flex;justify-content:space-between;margin-top:6px"><span>Core Sync</span><span style="color:#00ff88">LINKED ✓</span></div></div><button onclick="document.getElementById('modal').style.display='none'" style="margin-top:12px;width:100%;height:44px;border-radius:12px;background:#fff;color:#000;font-weight:900;border:none" class="orbitron">CLOSE</button></div>`;m.style.display='block'}
function openBuilds(){let m=document.getElementById('modal');let b=document.getElementById('modalBox');b.innerHTML=`<div style="padding:16px"><div class="orbitron" style="font-weight:900">BUILDS • 11 TRACKS</div><div style="margin-top:12px"><div style="background:#0a0a0a;border-left:3px solid #ff1a1a;padding:10px;margin-bottom:8px;border-radius:0 12px 12px 0"><b>FLG AI Assistant + Tagging</b><div style="font-size:10px;opacity:.6">Q4 2024 • Auto-tag 84% BETA</div><div class="bar"><div class="fill-red" style="width:84%"></div></div></div><div style="background:#0a0a0a;border-left:3px solid #facc15;padding:10px;margin-bottom:8px;border-radius:0 12px 12px 0"><b>Reactor Core v2 Skins</b><div style="font-size:10px;opacity:.6">Q1 2025 • 6 skins 62% ALPHA</div><div class="bar"><div class="fill-blue" style="width:62%"></div></div></div></div><button onclick="document.getElementById('modal').style.display='none'" style="margin-top:12px;width:100%;height:44px;border-radius:12px;background:#fff;color:#000;font-weight:900;border:none" class="orbitron">CLOSE</button></div>`;m.style.display='block'}
function openSystem(){let m=document.getElementById('modal');let b=document.getElementById('modalBox');b.innerHTML=`<div style="padding:16px"><div class="orbitron" style="font-weight:900">SYSTEM MONITOR • FL OS v3.1</div><div style="margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:8px">${Object.keys(CFG).map(k=>`<div style="background:#111;border:1px solid #222;border-radius:12px;padding:10px;text-align:center;font-size:11px;font-weight:800">${k}</div>`).join('')}</div><button onclick="document.getElementById('modal').style.display='none'" style="margin-top:12px;width:100%;height:44px;border-radius:12px;background:#fff;color:#000;font-weight:900;border:none" class="orbitron">CLOSE</button></div>`;m.style.display='block'}
renderPills();render();
if(recent.length>0){recent.forEach(r=>{let f=items.find(x=>x.id===r.id);if(f)f.plays++})}
</script>
